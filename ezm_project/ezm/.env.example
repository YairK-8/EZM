# Required in production
EZM_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional: enable the hidden developer console only when needed
# EZM_DEV_PASSWORD=replace-with-a-strong-dev-password

# Optional runtime paths
EZM_DATA_DIR=/data
EZM_DB_PATH=/data/ezm.sqlite3
PORT=5050

# OTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT=20

# Retention settings
EZM_OTP_TTL_SECONDS=600
EZM_WEEKS_RETENTION_DAYS=90
EZM_AUDIT_RETENTION_DAYS=60
EZM_OTP_RETENTION_DAYS=60
EZM_REPORTS_RETENTION_DAYS=90
